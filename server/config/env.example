# Synthetic Human Brain — server environment template
# Copy to .env and fill in real values. Never commit the filled-in copy.

# --- database ---------------------------------------------------------------
SYNTHETIC_BRAIN_DATABASE_URL=mysql+asyncmy://synthetic_brain:CHANGE_ME@127.0.0.1:3306/synthetic_brain

# --- API server -------------------------------------------------------------
SYNTHETIC_BRAIN_HOST=127.0.0.1
SYNTHETIC_BRAIN_PORT=8787
SYNTHETIC_BRAIN_LOG_LEVEL=info

# --- security ----------------------------------------------------------------
SYNTHETIC_BRAIN_JWT_SECRET=CHANGE_ME_64_RANDOM_HEX
SYNTHETIC_BRAIN_TOKEN_TTL_MINUTES=480

# --- rust backend (workers/servers registry) ---------------------------------
SYNTHETIC_BRAIN_RUST_BACKEND_URL=http://127.0.0.1:7800

# --- research limits ----------------------------------------------------------
SYNTHETIC_BRAIN_MAX_JOB_PAYLOAD_MB=64
SYNTHETIC_BRAIN_TELEMETRY_RETENTION_DAYS=90
